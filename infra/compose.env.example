# Copy to infra/.env (gitignored via .env.*) or export before compose.
# docker compose -f infra/docker-compose.yml --env-file infra/compose.env.example up

CONTEXTIQ_EMBEDDING_PROVIDER=sbert
CONTEXTIQ_GENERATOR=extractive
CONTEXTIQ_AUTH_MODE=open
CONTEXTIQ_RATE_LIMIT_PER_MINUTE=30
CONTEXTIQ_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8787

# Optional Postgres (compose --profile db) then set:
# DATABASE_URL=postgresql://contextiq:contextiq@db:5432/contextiq
