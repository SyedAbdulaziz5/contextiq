{
  "project": "ContextIQ",
  "corpus_name": "web-backend-cloud-docs",
  "description": "Primary demo corpus: Next.js + FastAPI official docs (easy for recruiters to try). Retained Phase 0 AWS Lambda / Bedrock / SST sources so the golden evaluation set stays valid. Same ingestion pipeline handles all three families.",
  "rationale": [
    "Next.js + FastAPI: immediately understandable demo ('ask the docs')",
    "AWS/SST/Bedrock: keeps Phase 0 golden.jsonl source_ids valid and matches infra stack",
    "Mixed HTML + Markdown/MDX stress-tests structure-preserving parsers",
    "Real public docs — not toy PDFs"
  ],
  "ingestion_plan": {
    "raw_zone": "corpus/raw/",
    "clean_zone": "corpus/clean/",
    "catalog_db": "corpus/catalog.sqlite",
    "formats": ["html", "markdown", "mdx", "pdf"],
    "target_page_count": "80+ seed pages now; expand toward 300–800",
    "note": "Local filesystem mirrors future S3 raw/clean zones. Postgres comes in Phase 3."
  },
  "sources": [
