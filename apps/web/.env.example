# ============================================================
# LOCAL DEVELOPMENT
# ============================================================
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
# Optional — shows GitHub CTA on the landing page
# NEXT_PUBLIC_GITHUB_URL=https://github.com/YOUR_USER/RAG_system
#
# Only if API uses CONTEXTIQ_AUTH_MODE=api_key.
# Prefer a server-side proxy for real secrets — never put production keys in NEXT_PUBLIC_*.
# NEXT_PUBLIC_API_KEY=same-as-CONTEXTIQ_API_KEY

# ============================================================
# PRODUCTION (set these in Vercel project → Settings → Environment Variables)
# ============================================================
# NEXT_PUBLIC_API_URL=https://your-api-host.railway.app
# NEXT_PUBLIC_GITHUB_URL=https://github.com/YOUR_USER/RAG_system
# NEXT_PUBLIC_API_KEY=<same as CONTEXTIQ_API_KEY on API host — demo only>
