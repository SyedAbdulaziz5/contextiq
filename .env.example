# ContextIQ — copy to .env (never commit .env)
#
# ============================================================
# LOCAL DEVELOPMENT (free, no cloud required)
# ============================================================
CONTEXTIQ_EMBEDDING_PROVIDER=sbert
CONTEXTIQ_SBERT_MODEL=BAAI/bge-small-en-v1.5
CONTEXTIQ_EMBED_DIMENSIONS=384
CONTEXTIQ_GENERATOR=extractive
CONTEXTIQ_OLLAMA_MODEL=llama3.2:1b
CONTEXTIQ_OLLAMA_BASE_URL=http://127.0.0.1:11434
#
# --- Security ---
# open = public demo + rate limits (default). api_key = require key.
CONTEXTIQ_AUTH_MODE=open
# CONTEXTIQ_API_KEY=change-me-long-random
# CONTEXTIQ_RATE_LIMIT_PER_MINUTE=30
# CONTEXTIQ_MAX_QUERY_CHARS=2000
# CONTEXTIQ_MAX_HISTORY_TURNS=20
# CONTEXTIQ_MAX_HISTORY_TURN_CHARS=2000
# CONTEXTIQ_MAX_TOP_K=20
CONTEXTIQ_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#
# ============================================================
# PRODUCTION (Railway / Render / Fly + Vercel)
# ============================================================
# CONTEXTIQ_AUTH_MODE=api_key
# CONTEXTIQ_API_KEY=<generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))">
# CONTEXTIQ_CORS_ORIGINS=https://your-app.vercel.app
# CONTEXTIQ_REPO_ROOT=/app
# CONTEXTIQ_RATE_LIMIT_PER_MINUTE=30
#
# ============================================================
# OPTIONAL — Postgres
# ============================================================
# DATABASE_URL=postgresql://contextiq:contextiq@localhost:5433/contextiq
#
# ============================================================
# OPTIONAL — AWS Bedrock (not required)
# ============================================================
# CONTEXTIQ_EMBEDDING_PROVIDER=bedrock
# CONTEXTIQ_GENERATOR=bedrock
# AWS_REGION=us-east-1
#
# ============================================================
# CI (no model downloads)
# ============================================================
# CONTEXTIQ_EMBEDDING_PROVIDER=hash
# CONTEXTIQ_GENERATOR=extractive
